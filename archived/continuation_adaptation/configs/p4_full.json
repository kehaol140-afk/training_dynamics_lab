    "lr_consumed_at_step": "value written at the accumulation-boundary micro batch (native semantics, native_schedule.set_native_micro_lr)",
    "endpoint_property": "gm_lr(2B) = 256 exactly; final LR = 0.1*base_lr = 5e-5 for every cell (schedule completes within B in all cells)",
